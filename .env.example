# ==========================================
# TigerSentry Environment Configuration
# ==========================================

# ------------------------------------------
# 1. TigerGraph Database Configuration
# ------------------------------------------
TG_HOST=https://your-instance.i.tgcloud.io
TG_GRAPH_NAME=FraudGraph
TG_USERNAME=tigergraph
TG_PASSWORD=your_password
TG_SECRET=your_restpp_secret
TG_API_TOKEN=your_token

# Execution Mode: 'cloud' or 'mock' (defaults to mock if credentials not provided)
TG_EXECUTION_MODE=mock

# ------------------------------------------
# 2. Free LLM Provider Configuration
# ------------------------------------------
# LLM_PROVIDER options:
# - 'auto'        : Automatically detects available key (Gemini -> Groq -> OpenRouter -> Mistral -> Offline)
# - 'gemini'      : Google Gemini (Free Tier API via Google AI Studio)
# - 'groq'        : Groq Cloud (Free Tier - ultra-fast LLaMA 3.3)
# - 'openrouter'  : OpenRouter (Free tier models)
# - 'mistral'     : Mistral AI (Free experiment tier)
# - 'offline'     : Built-in deterministic GraphRAG reasoner (No key required)
LLM_PROVIDER=auto

# Optional Model Override:
# - For Gemini    : gemini-2.5-flash (default), gemini-1.5-flash, gemini-2.0-flash-exp
# - For Groq      : llama-3.3-70b-versatile (default), llama-3.1-8b-instant
# - For OpenRouter: meta-llama/llama-3.1-8b-instruct:free, google/gemini-2.0-flash-exp:free
# - For Mistral   : mistral-small-latest
LLM_MODEL=

# Provider API Keys (Set whichever you have - zero required for offline mode):
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
LLM_API_KEY=

# LLM Generation Parameters
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SEC=12.0
