// ============================================================================
// TigerGraph Schema: Agentic Fraud Investigation Knowledge Graph (HHGOA)
// ============================================================================

CREATE GRAPH FraudGraph ()

// ----------------------------------------------------------------------------
// Vertex Definitions
// ----------------------------------------------------------------------------

CREATE SCHEMA_CHANGE JOB change_schema_for_fraud_graph FOR GRAPH FraudGraph {
    // Entities
    ADD VERTEX Customer(
        PRIMARY_ID id STRING,
        name STRING,
        email_prefix STRING,
        risk_tier STRING,
        registered_at DATETIME
    ) WITH STATS="OUTDEGREE_BY_EDGETYPE";

    ADD VERTEX Account(
        PRIMARY_ID id STRING,
        balance DOUBLE,
        status STRING,
        created_at DATETIME
    ) WITH STATS="OUTDEGREE_BY_EDGETYPE";

    ADD VERTEX Card(
        PRIMARY_ID id STRING,
        card1 STRING,
        card2 STRING,
        card3 STRING,
        card4 STRING,
        card6 STRING,
        issuer STRING
    ) WITH STATS="OUTDEGREE_BY_EDGETYPE";

    ADD VERTEX Transaction(
        PRIMARY_ID id STRING,
        amount DOUBLE,
        timestamp DATETIME,
        model_risk_score DOUBLE,
        dist1 DOUBLE,
        dist2 DOUBLE,
        is_online BOOL,
        product_cd STRING
    ) WITH STATS="OUTDEGREE_BY_EDGETYPE";

    ADD VERTEX Device(
        PRIMARY_ID id STRING,
        device_info STRING,
        device_type STRING
    ) WITH STATS="OUTDEGREE_BY_EDGETYPE";

    ADD VERTEX IPAddress(
        PRIMARY_ID id STRING,
        country STRING,
        city STRING,
        isp STRING,
        is_proxy BOOL
    ) WITH STATS="OUTDEGREE_BY_EDGETYPE";

    ADD VERTEX EmailDomain(
        PRIMARY_ID id STRING,
        domain_name STRING,
        is_disposable BOOL
    ) WITH STATS="OUTDEGREE_BY_EDGETYPE";

    ADD VERTEX Merchant(
        PRIMARY_ID id STRING,
        mcc STRING,
        merchant_name STRING,
        risk_score DOUBLE
    ) WITH STATS="OUTDEGREE_BY_EDGETYPE";

    ADD VERTEX FraudCase(
        PRIMARY_ID id STRING,
        status STRING,
        fraud_type STRING,
        risk_score DOUBLE,
        uncertainty DOUBLE,
        recommended_action STRING,
        approval_route STRING,
        sar_filed BOOL,
        created_at DATETIME,
        closed_at DATETIME,
        outcome STRING
    ) WITH STATS="OUTDEGREE_BY_EDGETYPE";

    // ------------------------------------------------------------------------
    // Edge Definitions
    // ------------------------------------------------------------------------

    ADD UNDIRECTED EDGE OWNS_ACCOUNT(FROM Customer, TO Account);
    ADD UNDIRECTED EDGE ACCOUNT_HAS_CARD(FROM Account, TO Card);
    ADD UNDIRECTED EDGE CARD_TRANSACTION(FROM Card, TO Transaction, txn_time DATETIME);
    ADD UNDIRECTED EDGE TXN_USED_DEVICE(FROM Transaction, TO Device);
    ADD UNDIRECTED EDGE TXN_USED_IP(FROM Transaction, TO IPAddress);
    ADD UNDIRECTED EDGE TXN_USED_EMAIL_DOMAIN(FROM Transaction, TO EmailDomain);
    ADD UNDIRECTED EDGE TXN_TARGETED_MERCHANT(FROM Transaction, TO Merchant);
    
    // Case Investigation & Case Memory Edges
    ADD UNDIRECTED EDGE TXN_IN_CASE(FROM Transaction, TO FraudCase);
    ADD UNDIRECTED EDGE CUSTOMER_IN_CASE(FROM Customer, TO FraudCase);
    ADD UNDIRECTED EDGE SIMILAR_CASE_LINK(FROM FraudCase, TO FraudCase, similarity DOUBLE, shared_features STRING);
}

RUN SCHEMA_CHANGE JOB change_schema_for_fraud_graph;
